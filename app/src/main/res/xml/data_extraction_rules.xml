<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone through Android backup or phone-to-phone transfer: the file index, adult-scan results
     and saved logins are private (logins are encrypted with a key that never leaves this phone anyway). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
