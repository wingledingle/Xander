<?xml version="1.0" encoding="utf-8"?>
<!-- All-in-one edition: Oleander runs inside Xander (Quinten's activities come from its library manifest). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Oleander GBA emulator (third_party/oleander). Its own task, so it sits in Recents like an app. -->
        <activity
            android:name="dev.oleander.app.MainActivity"
            android:label="Oleander"
            android:exported="false"
            android:taskAffinity="com.xander.files.oleander"
            android:launchMode="singleTask"
            android:theme="@style/OleanderTheme"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|smallestScreenSize"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
